<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Success - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    body{margin:0;padding:0;background:#0a0a0a;font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#f3f4f7;}
    .wrap{padding:20px 8px;}
    .card{max-width:620px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:16px;overflow:hidden;}
    .top{padding:18px 20px;background:linear-gradient(120deg,#0a3b1f,#0f5f2f);font-size:12px;font-weight:700;color:#cbf8da;}
    .hero{background:#59c86b;padding:22px 12px;text-align:center;color:#fff;font-size:36px;font-weight:800;}
    .sec{padding:20px;border-top:1px solid #292d35;}
    .sec h2{margin:0 0 10px;font-size:30px;}
    .sec p{margin:0;color:#cdd2db;font-size:16px;line-height:1.6;}
    .items{width:100%;border-collapse:collapse;margin-top:12px;border:1px solid #323742;border-radius:10px;overflow:hidden;}
    .items th,.items td{padding:10px;border-bottom:1px solid #2c3039;text-align:left;font-size:14px;}
    .items th{color:#efcb4a;background:#171a20;}
    .items tr:last-child td{border-bottom:none;}
    .progress-track{margin-top:14px;padding:18px;border:1px solid #263043;border-radius:18px;background:linear-gradient(180deg,#0e131b 0%,#0a1016 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.03);}
    .progress-head-row{width:100%;border-collapse:collapse;margin-bottom:14px;}
    .progress-head-title{color:#f5d15d;font-size:18px;letter-spacing:.5px;font-weight:800;text-transform:uppercase;}
    .progress-pill{font-size:11px;padding:6px 10px;border-radius:999px;background:rgba(245,209,93,.12);border:1px solid rgba(245,209,93,.25);color:#ffe8a3;white-space:nowrap;}
    .progress-grid{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;}
    .progress-grid td{padding:0 4px;vertical-align:top;}
    .step-card{position:relative;border:1px solid rgba(255,255,255,.06);border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));padding:14px 10px 12px;text-align:center;min-height:122px;}
    .step-card.done{border-color:rgba(63,208,106,.28);background:linear-gradient(180deg,rgba(63,208,106,.12),rgba(255,255,255,.018));box-shadow:0 0 0 1px rgba(63,208,106,.04),0 12px 24px rgba(0,0,0,.22);}
    .step-card.active{border-color:rgba(76,163,255,.28);background:linear-gradient(180deg,rgba(76,163,255,.12),rgba(255,255,255,.018));box-shadow:0 0 0 1px rgba(76,163,255,.04),0 12px 24px rgba(0,0,0,.22);}
    .step-card.pending{opacity:.92;}
    .step-dot{width:44px;height:44px;margin:0 auto 10px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;border:2px solid transparent;box-sizing:border-box;}
    .step-dot.done{background:linear-gradient(145deg,#3fe06d 0%,#24b45c 100%);border-color:#79f29d;box-shadow:0 10px 22px rgba(36,180,92,.30),0 0 0 7px rgba(63,224,109,.10);}
    .step-dot.active{background:linear-gradient(145deg,#62b2ff 0%,#3190eb 100%);border-color:#a7d4ff;box-shadow:0 10px 22px rgba(49,144,235,.30),0 0 0 7px rgba(98,178,255,.10);}
    .step-dot.pending{background:linear-gradient(145deg,#1c2230 0%,#121722 100%);border-color:#5c6477;color:#98a2b5;box-shadow:inset 0 0 0 1px rgba(255,255,255,.02);}
    .step-copy{min-height:52px;display:flex;flex-direction:column;justify-content:flex-start;}
    .step-label{font-size:11px;letter-spacing:1px;font-weight:800;color:#9ca6b8;text-transform:uppercase;line-height:1.35;}
    .step-label.done{color:#72f09c;}
    .step-label.active{color:#9ed0ff;}
    .step-label.pending{color:#7f8897;}
    .progress-bar{margin-top:14px;height:8px;background:#202532;border-radius:999px;overflow:hidden;}
    .progress-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#3fe06d 0%,#5ab8ff 55%,#a78bfa 100%);box-shadow:0 0 18px rgba(90,184,255,.35);}
    .progress-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:8px;font-size:12px;color:#92a0b6;line-height:1.4;}
    .progress-foot strong{color:#fff;}
    .btn{display:block;margin-top:14px;padding:12px;border-radius:10px;background:#4bbd60;color:#fff;text-decoration:none;text-align:center;font-weight:700;}
    .contact{margin-top:10px;text-align:center;}
    .contact a{display:inline-block;margin:4px;padding:9px 12px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:700;}
    .contact .mail{background:#101826;color:#d3e7ff;border:1px solid #355d8c;}
    .contact .call{background:#161a21;color:#ffe19f;border:1px solid #7f6528;}
    .contact .insta{background:linear-gradient(90deg,#ff8d3a,#d84ee4);color:#fff;}
    .foot{padding:16px;border-top:1px solid #292d35;text-align:center;color:#99a2b3;font-size:12px;}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">ORDER SUCCESS</div>
      <div class="hero">DELIVERED SUCCESSFULLY</div>
      <div class="sec">
        <h2>Thank You, {{userName}}</h2>
        <p>Your order <strong>{{orderId}}</strong> has been completed successfully.</p>
        <table class="items" role="presentation">
          <tr><th>Product</th><th>Qty</th><th>Price</th></tr>
          {{#each products}}
          <tr><td>{{this.name}}</td><td>{{#if this.quantity}}{{this.quantity}}{{else}}{{this.qty}}{{/if}}</td><td>INR {{this.price}}</td></tr>
          {{/each}}
        </table>
        <div class="progress-track">
          <table class="progress-head-row" role="presentation"><tr><td class="progress-head-title">DELIVERY PROGRESS</td><td align="right"><span class="progress-pill">{{progressPercent}}% COMPLETE</span></td></tr></table>
          <table class="progress-grid" role="presentation"><tr>
            {{#each progressSteps}}
            <td>
              <div class="step-card {{state}}">
                <span class="step-dot {{state}}">{{{icon}}}</span>
                <div class="step-copy"><div class="step-label {{state}}">{{label}}</div></div>
              </div>
            </td>
            {{/each}}
          </tr></table>
          <div class="progress-bar"><div class="progress-fill" style="width: {{progressPercent}}%;"></div></div>
          <div class="progress-foot"><span>Live status synced from backend</span><strong>{{progressPercent}}% done</strong></div>
        </div>
        <a class="btn" href="{{myOrdersUrl}}">View Order History</a>
        <div class="contact">
          <a class="mail" href="mailto:{{supportEmail}}">{{supportEmail}}</a>
          <a class="call" href="tel:{{supportPhone}}">{{supportPhone}}</a>
          <a class="insta" href="{{instagramUrl}}">Instagram</a>
        </div>
      </div>
      <div class="foot">eShopper Luxe</div>
    </div>
  </div>
</body>
</html>



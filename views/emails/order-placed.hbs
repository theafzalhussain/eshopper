<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Placed - {{orderId}}</title>
  <style>
    body{margin:0;padding:0;background:#0a0a0a;font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#f5f5f5;}
    .wrap{padding:20px 8px;}
    .card{max-width:620px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:16px;overflow:hidden;}
    .top{padding:18px 20px;background:linear-gradient(120deg,#232526,#414345 80%);box-shadow:0 2px 16px 0 #0008,0 1.5px 0 #ffd70033 inset;border-bottom:2px solid #ffd700;letter-spacing:1.2px;text-shadow:0 1px 8px #000a;display:flex;align-items:center;justify-content:space-between;gap:10px;}
    .brandmark{display:inline-table;vertical-align:middle;border-collapse:collapse;}
    .brandmark td{padding:0;vertical-align:top;}
    .brandmark-e-cell{padding-right:8px !important;}
    .brandmark-e{background:linear-gradient(145deg,#0f172a 0%,#1e293b 55%,#0f172a 100%);color:#fff;width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-size:17px;font-weight:800;border-radius:4px;border-right:3px solid #d4af37;line-height:28px;}
    .brandmark-text{display:table-cell;line-height:1;}
    .brandmark-name{display:block;font-weight:800;letter-spacing:2px;font-size:14px;color:#f5f7fb;line-height:1;}
    .brandmark-tag{display:block;font-size:6px;letter-spacing:1.6px;color:#d4af37;font-weight:700;margin-top:2px;line-height:1.1;}
    .hero{background:#49b84f;padding:22px 12px;text-align:center;color:#fff;font-size:34px;font-weight:800;}
    .sec{padding:20px;border-top:1px solid #292d35;}
    .sec h2{margin:0 0 10px;font-size:30px;}
    .sec p{margin:0 0 8px;color:#cdd2db;font-size:16px;line-height:1.6;}
    .foot{padding:16px;border-top:1px solid #292d35;text-align:center;color:#99a2b3;font-size:12px;}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">
        <span>ORDER PLACED</span>
        <table role="presentation" class="brandmark" cellpadding="0" cellspacing="0"><tr><td class="brandmark-e-cell"><span class="brandmark-e">E</span></td><td class="brandmark-text"><span class="brandmark-name">SHOPPER</span><span class="brandmark-tag">BOUTIQUE LUXE</span></td></tr></table>
      </div>
      <div class="hero">ORDER PLACED</div>
      <div class="sec">
        <h2>Hi {{userName}}!</h2>
        <p>Your order has been placed successfully. We will notify you once it is confirmed and processed.</p>
      </div>
      <div class="foot">
        <table role="presentation" class="brandmark" cellpadding="0" cellspacing="0" style="margin-bottom:2px"><tr><td class="brandmark-e-cell"><span class="brandmark-e">E</span></td><td class="brandmark-text"><span class="brandmark-name">SHOPPER</span><span class="brandmark-tag">BOUTIQUE LUXE</span></td></tr></table>
        <span style="font-size:12px;color:#ffd700;">https://eshopperr.me</span>
      </div>
    </div>
  </div>
</body>
</html>

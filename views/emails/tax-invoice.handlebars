<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tax Invoice - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    body{margin:0;padding:0;background:#0a0a0a;font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#f5f5f5;}
    .wrap{padding:20px 8px;}
    .card{max-width:700px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:16px;overflow:hidden;}
    .top{padding:18px 20px;background:linear-gradient(120deg,#3b2508,#5a360a);font-size:12px;font-weight:700;color:#ffd98f;}
    .hero{background:#8d661b;padding:18px 12px;text-align:center;color:#fff;font-size:30px;font-weight:800;}
    .sec{padding:20px;border-top:1px solid #292d35;}
    .meta{border:1px solid #3e3a2d;border-radius:10px;padding:12px;background:#17140f;color:#e9dfc5;line-height:1.7;font-size:14px;}
    .items{width:100%;border-collapse:collapse;margin-top:12px;border:1px solid #323742;border-radius:10px;overflow:hidden;}
    .items th,.items td{padding:10px;border-bottom:1px solid #2c3039;text-align:left;font-size:14px;}
    .items th{color:#efcb4a;background:#171a20;}
    .items tr:last-child td{border-bottom:none;}
    .totals{margin-top:12px;border:1px solid #323742;border-radius:10px;padding:12px;background:#111317;}
    .totals table{width:100%;}
    .totals td{padding:6px 0;font-size:15px;color:#d6d9e0;}
    .totals .f td{border-top:1px solid #2f3340;padding-top:10px;color:#efcb4a;font-weight:800;font-size:18px;}
    .progress-track{margin-top:14px;border:1px solid #323844;border-radius:12px;padding:14px;background:linear-gradient(140deg,#0f131a,#182033,#111827);}
    .progress-head{margin:0 0 10px;color:#f8d98a;font-size:20px;letter-spacing:.3px;text-align:center;font-weight:800;}
    .progress-grid{width:100%;border-collapse:collapse;}
    .progress-grid td{text-align:center;padding:4px 2px;width:20%;}
    .p-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:999px;font-size:17px;border:1px solid #3a404d;background:#1b212d;}
    .p-icon.done{background:#2ea94b;border-color:#55d372;}
    .p-icon.active{background:#2f8fe2;border-color:#6fc3ff;}
    .p-icon.pending{background:#1b212d;border-style:dashed;color:#8a93a5;}
    .p-label{margin-top:6px;font-size:11px;letter-spacing:.4px;font-weight:700;color:#8f98aa;text-transform:uppercase;}
    .p-label.done{color:#5fda7f;}
    .p-label.active{color:#7bc6ff;}
    .p-bar{margin-top:10px;height:4px;background:#2a2e37;border-radius:999px;overflow:hidden;}
    .p-fill{height:100%;background:linear-gradient(90deg,#34d399,#60a5fa,#a78bfa);border-radius:999px;}
    .cta{margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;}
    .btn{display:inline-block;padding:10px 12px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:700;}
    .btn-primary{background:#b6862d;color:#fff;}
    .btn-secondary{background:#111722;color:#d6e8ff;border:1px solid #3c5f8a;}
    .foot{padding:16px;border-top:1px solid #292d35;text-align:center;color:#99a2b3;font-size:12px;line-height:1.7;}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">OFFICIAL TAX INVOICE</div>
      <div class="hero">TAX INVOICE #{{orderId}}</div>
      <div class="sec">
        <div class="meta">
          <div>Customer: {{userName}}</div>
          <div>Email: {{userEmail}}</div>
          <div>Payment Method: {{paymentMethod}}</div>
          <div>Payment Status: {{paymentStatus}}</div>
          <div>Order Date: {{orderDate}}</div>
        </div>
        <table class="items" role="presentation">
          <tr><th>Product</th><th>Qty</th><th>Price</th></tr>
          {{#each products}}
          <tr><td>{{this.name}}</td><td>{{this.qty}}</td><td>INR {{this.price}}</td></tr>
          {{/each}}
        </table>
        <div class="totals">
          <table role="presentation">
            <tr><td>Subtotal</td><td align="right">INR {{totalAmount}}</td></tr>
            <tr><td>Shipping</td><td align="right">INR {{shippingAmount}}</td></tr>
            <tr class="f"><td>Total Payable</td><td align="right">INR {{finalAmount}}</td></tr>
          </table>
        </div>
        <div class="progress-track">
          <div class="progress-head">DELIVERY PROGRESS</div>
          <table class="progress-grid" role="presentation"><tr>
            {{#each progressSteps}}
            <td>
              <span class="p-icon {{state}}">{{{icon}}}</span>
              <div class="p-label {{state}}">{{label}}</div>
            </td>
            {{/each}}
          </tr></table>
          <div class="p-bar"><div class="p-fill" style="width: {{progressPercent}}%;"></div></div>
        </div>
        <div class="cta">
          <a class="btn btn-primary" href="{{invoiceDownloadUrl}}">Download Invoice</a>
          <a class="btn btn-secondary" href="{{myOrdersUrl}}">View My Orders</a>
        </div>
      </div>
      <div class="foot">eShopper Luxe</div>
    </div>
  </div>
</body>
</html>



<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;600&display=swap');
    a:hover { opacity: 0.85; }
    /* Premium Delivery Progress Styles */
    .step-icon-done { border-color: #d4af37 !important; background: #1a1813 !important; color: #d4af37 !important; }
    .step-label-done { color: #d4af37 !important; }
    .step-icon-active { border-color: #f8d98a !important; background: linear-gradient(135deg, #d4af37 0%, #aa8222 100%) !important; color: #000000 !important; box-shadow: 0 0 14px rgba(212,175,55,0.6) !important; }
    .step-label-active { color: #f8d98a !important; font-weight: 800 !important; }
    .step-icon-pending { border-color: #222222 !important; background: #0a0a0c !important; color: #555555 !important; }
    .step-label-pending { color: #666666 !important; }
    @media only screen and (max-width:620px) {
      .step-icon-done, .step-icon-active, .step-icon-pending { width: 22px !important; height: 22px !important; line-height: 20px !important; font-size: 10px !important; margin-bottom: 6px !important; border-width: 1px !important; }
      .step-label-done, .step-label-active, .step-label-pending { font-size: 8px !important; letter-spacing: 0px !important; }
      .luxe-journey-title { font-size: 14px !important; }
      .luxe-percent-pill { font-size: 9px !important; padding: 4px 8px !important; }
    }
  </style>
</head>

<body
  style="margin:0;padding:0;background:#050608;font-family:'Inter', 'Trebuchet MS', Arial, sans-serif;color:#f5f5f5;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{orderId}} confirmed. Premium preparation is
    in progress.</div>
  {{> animated-gold-border}}
  <table role="presentation" width="100%" style="width:100%;background:#050608;padding:16px 6px;">
    <tr>
      <td>
        <table role="presentation" align="center"
          style="width:100%;max-width:640px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:18px;overflow:hidden;">
          <tr>
            <td style="padding:16px 20px;background:linear-gradient(120deg,#0d2315,#12311f,#1b3a2b);">
              <table role="presentation" style="display:inline-table;vertical-align:middle;border-collapse:collapse;">
                <tr>
                  <td style="padding-right:8px;vertical-align:top;">
                    <span
                      style="background:linear-gradient(145deg,#0f172a 0%,#1e293b 55%,#0f172a 100%);color:#fff;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:800;border-radius:4px;border-right:3px solid #d4af37;box-shadow:0 6px 16px rgba(15,23,42,0.22);line-height:34px;">E</span>
                  </td>
                  <td style="vertical-align:top;">
                    <span
                      style="display:block;font-weight:800;letter-spacing:2.4px;font-size:18px;color:#f5f7fb;line-height:1;">SHOPPER</span>
                    <span
                      style="display:block;font-size:7px;letter-spacing:1.8px;color:#d4af37;font-weight:700;margin-top:2px;line-height:1.1;">BOUTIQUE
                      LUXE</span>
                  </td>
                </tr>
              </table>
              <span
                style="float:right;display:inline-block;font-size:12px;font-weight:700;color:#dbffe8;border:1px solid #4aba65;background:#2f8d44;padding:7px 12px;border-radius:999px;">CONFIRMED</span>
            </td>
          </tr>
          <tr>
            <td
              style="background:linear-gradient(120deg,#111111,#1a1813);border-bottom:2px solid #d4af37;text-align:center;padding:35px 15px;">
              <div
                style="font-family:'Playfair Display', Georgia, serif;font-style:italic;font-size:24px;color:#d4af37;margin-bottom:12px;">
                Thank you, {{customerName}}</div>
              <div style="font-family:'Playfair Display', Georgia, serif;font-size:34px;font-weight:700;line-height:1.2;letter-spacing:1.5px;text-transform:uppercase;color:#ffffff;">ORDER CONFIRMED</div>
              <div style="color:#c5a059;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-top:14px;">Order #{{orderId}} &bull; {{orderDate}}
              </div>
            </td>
          </tr>

          <tr>
            <td class="section" style="padding:22px 20px;border-top:1px solid #272a30;">
              <h2 class="title" style="font-family:'Playfair Display', Georgia, serif; font-size:22px; color:#d4af37; font-weight:400;">Hi {{customerName}},</h2>
              <p class="sub">Your order has been confirmed and is now being prepared by our expert team. Every item will
                undergo our strict 10-point quality inspection before dispatch.</p>
              <div class="arrival">
                <div class="h">EXPECTED ARRIVAL</div>
                <div class="d">{{expectedArrival}}</div>
                <div class="s">3-5 Business Days</div>
              </div>

              <div style="margin-top:28px; background:linear-gradient(145deg, #0a0a0c, #111111); border:1px solid #2a2a2a; border-radius:16px; padding:24px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <table role="presentation" style="width:100%; margin-bottom:20px;">
                  <tr>
                    <td class="luxe-journey-title" style="font-family:'Playfair Display', Georgia, serif; font-size:18px; color:#d4af37; font-weight:600; letter-spacing:1px;">
                      The Luxe Journey
                    </td>
                    <td align="right">
                      <span class="luxe-percent-pill" style="font-size:10px; background:linear-gradient(135deg, #1a1813, #0a0a0c); color:#d4af37; padding:6px 12px; border-radius:999px; font-weight:800; border:1px solid #d4af37; letter-spacing:1.5px; box-shadow: 0 0 10px rgba(212,175,55,0.15);">
                        {{progressPercent}}% COMPLETE
                      </span>
                    </td>
                  </tr>
                </table>

                <div style="width:100%; height:4px; background:#1a1a1a; border-radius:4px; margin-bottom:24px; overflow:hidden; border: 1px solid #222;">
                  <div style="height:100%; background:linear-gradient(90deg, #8b6a12, #d4af37, #fffbe6); width:{{progressPercent}}%; border-radius:4px; box-shadow: 0 0 12px rgba(212,175,55,0.8);"></div>
                </div>

                <table role="presentation" style="width:100%; text-align:center; table-layout:fixed;">
                  <tr>
                    {{#each progressSteps}}
                    <td style="vertical-align:top; padding:0 2px;">
                      <div class="step-icon-{{state}}" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:13px; margin-bottom:10px; border: 2px solid #222; background: #0a0a0c; color: #555; box-sizing:border-box;">
                        {{{icon}}}
                      </div>
                      <div class="step-label-{{state}}" style="font-size:10px; color:#666; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">
                        {{label}}
                      </div>
                    </td>
                    {{/each}}
                  </tr>
                </table>

                <div style="margin-top:24px; padding-top:16px; border-top:1px solid #222; font-size:11px; color:#888; text-align:center; font-style:italic; font-family:Georgia, serif;">
                  Live status synced automatically with our premium dispatch center.
                </div>
              </div>
            </td>
          </tr>

          <tr>
            <td class="promise"
              style="background:#032312;border-top:1px solid #0f4f2a;border-bottom:1px solid #0f4f2a;padding:18px 12px;">
              <h3>THE LUXE PROMISE</h3>
              <table class="pgrid" role="presentation">
                <tr>
                  <td><span class="i">&#10003;</span>
                    <div class="t">Quality Check</div>
                    <div class="d">10-point inspection by experts</div>
                  </td>
                  <td><span class="i">&#9671;</span>
                    <div class="t">Premium Packaging</div>
                    <div class="d">Eco-friendly luxury boxes</div>
                  </td>
                  <td><span class="i">&#9679;</span>
                    <div class="t">100% Authentic</div>
                    <div class="d">Guaranteed genuine products</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="section" style="padding:22px 20px;border-top:1px solid #272a30;">
              <div class="box" style="border:1px solid #2a2a2a;border-radius:8px;padding:20px;background:#0d0e10;">
                <h3 class="heading" style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:26px;margin:0 0 16px;letter-spacing:1px;text-transform:uppercase;">ORDER DETAILS</h3>
                <table class="items" role="presentation" width="100%"
                  style="width:100%;border:1px solid #222;border-radius:6px;overflow:hidden;">
                  <tr>
                    <th
                      style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">
                      ITEM</th>
                    <th
                      style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">
                      DETAILS</th>
                    <th
                      style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">
                      QTY</th>
                    <th
                      style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">
                      PRICE</th>
                  </tr>
                  {{#each items}}
                  <tr>
                    <td><img class="thumb" src="{{imageUrl}}" alt="{{name}}"
                        style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid #3a3e48;max-width:100%;display:block;" />
                    </td>
                    <td><strong>{{name}}</strong><br><span class="dim" style="color:#b4bac6;">Size:
                        {{size}}</span><br><span class="dim" style="color:#b4bac6;">Color: {{color}}</span></td>
                    <td>{{#if quantity}}{{quantity}}{{else}}{{qty}}{{/if}}</td>
                    <td>INR {{subtotal}}</td>
                  </tr>
                  {{/each}}
                </table>

                <div class="totals" style="margin-top:14px;border:1px solid #343844;border-radius:12px;padding:16px;">
                  <table role="presentation" style="width:100%;">
                    <tr>
                      <td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Item Price</td>
                      <td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{subtotal}}</td>
                    </tr>
                    <tr>
                      <td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Shipping Charges</td>
                      <td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{shippingCharges}}</td>
                    </tr>
                    <tr>
                      <td style="padding:5px 0;color:#d5d9e2;font-size:16px;">GST (Included)</td>
                      <td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{gst}}</td>
                    </tr>
                    <tr class="final">
                      <td
                        style="border-top:1px solid #2c3140;padding-top:10px;color:#efcb4a;font-size:48px;font-weight:800;">
                        Total Amount Paid</td>
                      <td align="right"
                        style="border-top:1px solid #2c3140;padding-top:10px;color:#efcb4a;font-size:48px;font-weight:800;">
                        INR {{totalPaid}}</td>
                    </tr>
                    <tr>
                      <td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Payment Mode: {{paymentMethod}}</td>
                      <td class="paid" style="color:#21c05c;font-size:14px;text-align:right;padding-top:0;">&#10003;
                        PAID</td>
                    </tr>
                  </table>
                </div>

                <table class="grid" role="presentation" style="width:100%;margin-top:14px;">
                  <tr>
                    <td style="width:50%;vertical-align:top;">
                      <div class="mini"
                        style="border:1px solid #0f6f35;background:#101a12;border-radius:12px;padding:14px;margin-right:8px;">
                        <div class="k"
                          style="font-size:13px;color:#36d76d;margin-bottom:8px;font-weight:700;letter-spacing:.3px;">
                          SHIPPING ADDRESS</div>
                        <div class="v" style="color:#e7e9ed;font-size:16px;line-height:1.45;">
                          {{shippingName}}<br>{{shippingAddressLine1}}<br>{{shippingAddressLine2}}<br>{{shippingAddressLine3}}<br>Phone:
                          {{shippingPhone}}</div>
                      </div>
                    </td>
                    <td style="width:50%;vertical-align:top;">
                      <div class="mini2"
                        style="border:1px solid #343944;background:#111317;border-radius:12px;padding:14px;margin-left:8px;">
                        <div class="k2"
                          style="font-size:13px;color:#efcb4a;margin-bottom:8px;font-weight:700;letter-spacing:.3px;">
                          BILLING INFO</div>
                        <div class="v" style="color:#e7e9ed;font-size:16px;line-height:1.45;">{{customerName}}<br>Email:
                          {{customerEmail}}<br>Transaction ID:<br><span class="tx"
                            style="color:#e0bc52;">{{transactionId}}</span></div>
                      </div>
                    </td>
                  </tr>
                </table>

                <a class="btn mobile-btn" href="{{trackingUrl}}" target="_blank"
                  style="display:block;text-align:center;text-decoration:none;font-weight:600;border-radius:8px;padding:16px 12px;font-size:16px;margin-top:24px;background:linear-gradient(135deg, #4ab75a 0%, #2e8f38 100%);color:#ffffff;letter-spacing:1.5px;text-transform:uppercase;box-shadow:0 4px 12px rgba(74,183,90,0.3);">TRACK YOUR ORDER</a>
                <a class="btn mobile-btn" href="{{confirmationInvoiceUrl}}" target="_blank"
                  style="display:block;text-align:center;text-decoration:none;font-weight:600;border-radius:8px;padding:16px 12px;font-size:16px;margin-top:14px;background:#151820;color:#f0d07a;border:1px solid #756225;letter-spacing:1.5px;text-transform:uppercase;box-shadow:0 4px 12px rgba(240,208,122,0.15);">VIEW RECEIPT</a>
              </div>
            </td>
          </tr>

          <tr>
            <td class="foot" style="padding:24px 14px;border-top:1px solid #1a1a1a;text-align:center;color:#9ea4b2;font-size:12px;line-height:1.7;background:#0b0c0e;">
              <div class="community" style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:20px;font-style:italic;">Join our Luxe community</div>
              <div class="stars" style="color:#f4d64b;font-size:28px;letter-spacing:2px;margin:8px 0;">
                &#9733;&#9733;&#9733;&#9733;&#9733;</div>
            </td>
          </tr>

          <tr>
            <td class="assist" style="padding:18px 20px;border-top:1px solid #2a2e36;text-align:center;">
              <h4 style="font-family:'Playfair Display', Georgia, serif;margin:0 0 10px;font-size:28px;color:#f1f2f5;font-weight:400;">Need Assistance?</h4>
              <div style="    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;    flex-wrap: wrap;">
                <a class="mobile-flex-btn" href="{{whatsappUrl}}" target="_blank" style="background:linear-gradient(90deg,#25d366,#1ed66d);color:#0f1912;text-decoration:none;border-radius:10px;padding:14px 20px;font-weight:800;display:inline-block;text-align:center;min-width:140px;box-shadow:0 4px 12px rgba(37,211,102,0.25);">WhatsApp Support</a>
                <a class="mobile-flex-btn" href="{{instagramUrl}}" target="_blank" style="background:linear-gradient(90deg,#ff8d3a,#d84ee4);color:#fff;text-decoration:none;border-radius:10px;padding:14px 20px;font-weight:800;display:inline-block;text-align:center;min-width:140px;box-shadow:0 4px 12px rgba(216,78,228,0.25);">Instagram</a>
              </div>
            </td>
          </tr>

          <tr>
            <td class="footnote"
              style="text-align:center;color:#9ea4b2;font-size:12px;padding:18px 14px 24px;border-top:1px solid #272a30;line-height:1.7;">
              {{> review-snippet}}
              {{> social-footer}}
              {{> brand-story-footer}}
              <div style="margin-top:10px;">&copy; 2024 E-Shopper Boutique Luxe. All rights reserved.</div>
              <div>{{companyAddress}}</div>
              <div>GSTIN: {{companyGstin}} | CIN: {{companyCin}}</div>
              <div style="margin-top: 14px;">
                <a href="{{privacyPolicyUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Privacy</a> | 
                <a href="{{termsUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Terms</a> | 
                <a href="{{unsubscribeUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Unsubscribe</a>
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
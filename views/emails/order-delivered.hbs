<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Delivered - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;600&display=swap');
    a:hover { opacity: 0.85; }
    /* Premium Delivery Progress Styles */
    .step-icon-done { border-color: #d4af37 !important; background: #1a1813 !important; color: #d4af37 !important; }
    .step-label-done { color: #d4af37 !important; }
    .step-icon-active { border-color: #f8d98a !important; background: linear-gradient(135deg, #d4af37 0%, #aa8222 100%) !important; color: #000000 !important; box-shadow: 0 0 14px rgba(212,175,55,0.6) !important; }
    .step-label-active { color: #f8d98a !important; font-weight: 800 !important; }
    .step-icon-pending { border-color: #222222 !important; background: #0a0a0c !important; color: #555555 !important; }
    .step-label-pending { color: #666666 !important; }
    @media only screen and (max-width:620px) {
      .step-icon-done, .step-icon-active, .step-icon-pending { width: 22px !important; height: 22px !important; line-height: 20px !important; font-size: 10px !important; margin-bottom: 6px !important; border-width: 1px !important; }
      .step-label-done, .step-label-active, .step-label-pending { font-size: 8px !important; letter-spacing: 0px !important; }
      .luxe-journey-title { font-size: 14px !important; }
      .luxe-percent-pill { font-size: 9px !important; padding: 4px 8px !important; }
      .btn-row td { display: block; width: 100%; padding:0 !important; }
      .igrid td { display: block; width: 100%; padding:0 0 10px 0 !important; }
      
      /* Global Responsive Classes */
      .mobile-stack { display: block !important; width: 100% !important; padding: 0 12px !important; margin-bottom: 16px !important; box-sizing: border-box !important; }
      .mobile-btn { display: inline-block !important; width: auto !important; min-width: 220px !important; box-sizing: border-box !important; margin: 8px 4px !important; }
      .mobile-flex-btn { width: 100% !important; min-width: unset !important; margin-left: 0 !important; margin-right: 0 !important; margin-bottom: 10px !important; }
      .mobile-hero-title { font-size: 26px !important; line-height: 1.3 !important; }
      .mobile-section-title { font-size: 20px !important; }
      .mobile-table-header { font-size: 11px !important; padding: 8px 4px !important; }
      .mobile-table-cell { font-size: 13px !important; padding: 10px 4px !important; }
      .mobile-thumb { width: 50px !important; height: 50px !important; }
      .mobile-otp { font-size: 22px !important; padding: 12px 20px !important; letter-spacing: 2px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#050608;font-family:'Inter', 'Trebuchet MS', Arial, sans-serif;color:#f5f5f5;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Delivered successfully - {{orderId}}. Your tax invoice is ready.</div>
  <table role="presentation" width="100%" style="width:100%;background:#050608;padding:16px 6px;"><tr><td>
    <table role="presentation" align="center" style="width:100%;max-width:640px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:18px;overflow:hidden;">
      {{> animated-gold-border}}
      <tr><td style="padding:16px 20px;background:linear-gradient(120deg,#0d2315,#12311f,#1b3a2b);">
        <table role="presentation" style="display:inline-table;vertical-align:middle;border-collapse:collapse;">
          <tr>
            <td style="padding-right:8px;vertical-align:top;">
              <span style="background:linear-gradient(145deg,#0f172a 0%,#1e293b 55%,#0f172a 100%);color:#fff;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:800;border-radius:4px;border-right:3px solid #d4af37;box-shadow:0 6px 16px rgba(15,23,42,0.22);line-height:34px;">E</span>
            </td>
            <td style="vertical-align:top;">
              <span style="display:block;font-weight:800;letter-spacing:2.4px;font-size:18px;color:#f5f7fb;line-height:1;">SHOPPER</span>
              <span style="display:block;font-size:7px;letter-spacing:1.8px;color:#d4af37;font-weight:700;margin-top:2px;line-height:1.1;">BOUTIQUE LUXE</span>
            </td>
          </tr>
        </table>
        <span style="float:right;display:inline-block;font-size:12px;font-weight:700;color:#000000;border:1px solid #d4af37;background:linear-gradient(135deg, #d4af37 0%, #aa8222 100%);padding:7px 12px;border-radius:999px;">DELIVERED</span>
      </td></tr>

      <tr>
        <td style="background:linear-gradient(120deg,#111111,#1a1813);border-bottom:2px solid #d4af37;text-align:center;padding:35px 15px;">
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:42px;color:#d4af37;line-height:1;margin-bottom:12px;">&#10003;</div>
          <div class="mobile-hero-title" style="font-family:'Playfair Display', Georgia, serif;font-size:34px;font-weight:700;line-height:1.2;letter-spacing:1.5px;text-transform:uppercase;color:#ffffff;">ORDER DELIVERED</div>
          <div style="color:#c5a059;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-top:14px;">Order #{{orderId}} &bull; {{deliveredOn}}</div>
        </td>
      </tr>

      <tr>
        <td class="section" style="padding:30px 20px;border-top:1px solid #272a30;">
          <h2 class="title" style="font-family:'Playfair Display', Georgia, serif; font-size:26px; color:#d4af37; font-weight:400;text-align:center;margin:0 0 14px;">Thank You, {{customerName}}</h2>
          <p class="sub" style="color:#d6dae2;font-size:16px;line-height:1.62;margin:0 0 16px;text-align:center;">We hope you love your luxury purchase!</p>
          
          <div style="text-align:center;margin-top:0;padding:16px;background:#0d0e10;border-radius:12px;border:1px solid #2a2a2a;margin-bottom:24px;">
            <div style="font-size:12px;color:#888;letter-spacing:1px;margin-bottom:4px;font-weight:700;">DELIVERY CONFIRMED</div>
            <div style="font-size:14px;color:#aaa;margin-top:6px;">Received by <span style="color:#fff;font-weight:600;">{{receivedBy}}</span></div>
          </div>

        {{> review-snippet}}

          <div style="margin-top:28px; background:linear-gradient(145deg, #0a0a0c, #111111); border:1px solid #2a2a2a; border-radius:16px; padding:24px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
            <table role="presentation" style="width:100%; margin-bottom:20px;">
              <tr>
                <td class="luxe-journey-title" style="font-family:'Playfair Display', Georgia, serif; font-size:18px; color:#d4af37; font-weight:600; letter-spacing:1px;">
                  The Luxe Journey
                </td>
                <td align="right">
                  <span class="luxe-percent-pill" style="font-size:10px; background:linear-gradient(135deg, #1a1813, #0a0a0c); color:#d4af37; padding:6px 12px; border-radius:999px; font-weight:800; border:1px solid #d4af37; letter-spacing:1.5px; box-shadow: 0 0 10px rgba(212,175,55,0.15);">
                    100% COMPLETE
                  </span>
                </td>
              </tr>
            </table>

            <div style="width:100%; height:4px; background:#1a1a1a; border-radius:4px; margin-bottom:24px; overflow:hidden; border: 1px solid #222;">
              <div style="height:100%; background:linear-gradient(90deg, #8b6a12, #d4af37, #fffbe6); width:100%; border-radius:4px; box-shadow: 0 0 12px rgba(212,175,55,0.8);"></div>
            </div>

            <table role="presentation" style="width:100%; text-align:center; table-layout:fixed;">
              <tr>
                <!-- Step 1: Placed -->
                <td style="vertical-align:top; padding:0 2px;">
                  <div class="step-icon-done" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:14px; font-weight:800; margin-bottom:10px; border: 2px solid #d4af37; background: #1a1813; color: #d4af37; box-sizing:border-box;">&#10003;</div>
                  <div class="step-label-done" style="font-size:10px; color:#d4af37; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">PLACED</div>
                </td>
                <!-- Step 2: Packed -->
                <td style="vertical-align:top; padding:0 2px;">
                  <div class="step-icon-done" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:14px; font-weight:800; margin-bottom:10px; border: 2px solid #d4af37; background: #1a1813; color: #d4af37; box-sizing:border-box;">&#10003;</div>
                  <div class="step-label-done" style="font-size:10px; color:#d4af37; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">PACKED</div>
                </td>
                <!-- Step 3: Shipped -->
                <td style="vertical-align:top; padding:0 2px;">
                  <div class="step-icon-done" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:14px; font-weight:800; margin-bottom:10px; border: 2px solid #d4af37; background: #1a1813; color: #d4af37; box-sizing:border-box;">&#10003;</div>
                  <div class="step-label-done" style="font-size:10px; color:#d4af37; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">SHIPPED</div>
                </td>
                <!-- Step 4: Out for Delivery -->
                <td style="vertical-align:top; padding:0 2px;">
                  <div class="step-icon-done" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:14px; font-weight:800; margin-bottom:10px; border: 2px solid #d4af37; background: #1a1813; color: #d4af37; box-sizing:border-box;">&#10003;</div>
                  <div class="step-label-done" style="font-size:10px; color:#d4af37; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">OUT FOR DLVY</div>
                </td>
                <!-- Step 5: Delivered (Active/Final) -->
                <td style="vertical-align:top; padding:0 2px;">
                  <div class="step-icon-active" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:15px; font-weight:900; margin-bottom:10px; border: 2px solid #f8d98a; background: linear-gradient(135deg, #d4af37 0%, #aa8222 100%); color: #000000; box-shadow: 0 0 14px rgba(212,175,55,0.6); box-sizing:border-box;">&#10022;</div>
                  <div class="step-label-active" style="font-size:10px; color:#f8d98a; font-weight:800; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">DELIVERED</div>
                </td>
              </tr>
            </table>
          </div>

          <div style="margin-top:28px;border:1px solid #d4af37;border-radius:12px;padding:24px;background:#1a1813;text-align:center;box-shadow: 0 4px 15px rgba(212,175,55,0.1);">
            <div style="font-size:32px;color:#d4af37;margin-bottom:8px;">&#9671;</div>
            <h3 style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:24px;margin:0 0 8px;">Your Tax Invoice is Ready</h3>
            <p style="color:#d3c7a8;font-size:15px;margin:0 0 20px;">Download your official GST invoice for warranty, return, and tax purposes.</p>
            <div style="text-align: center; margin-top: 16px;">
              <a class="mobile-btn" href="{{finalInvoiceUrl}}" target="_blank" style="display:inline-block;text-align:center;text-decoration:none;font-weight:700;border-radius:6px;padding:16px 24px;font-size:13px;background:linear-gradient(135deg, #d4af37 0%, #aa8222 100%);color:#000000;letter-spacing:1px;text-transform:uppercase;margin:8px 6px;min-width:200px;box-sizing:border-box;">DOWNLOAD TAX INVOICE</a>
            </div>
          </div>

          <div style="margin-top:24px;border:1px solid #2a2a2a;border-radius:12px;padding:24px;background:#0d0e10;text-align:center;">
            <h4 style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:20px;margin:0 0 8px;">How was your experience?</h4>
            <p style="color:#c8cdd7;font-size:15px;margin:0;">Rate your order and help us serve you better</p>
            <div style="color:#f4d64b;font-size:36px;letter-spacing:6px;margin:12px 0;line-height:1;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <div style="text-align: center; margin-top: 10px;">
              <a class="mobile-btn" href="{{reviewUrl}}" target="_blank" style="display:inline-block;text-align:center;text-decoration:none;font-weight:700;border-radius:6px;padding:16px 24px;font-size:13px;background:#0a0a0c;color:#d4af37;border:1px solid #d4af37;letter-spacing:1px;text-transform:uppercase;margin:8px 6px;min-width:200px;box-sizing:border-box;">WRITE A REVIEW</a>
            </div>
          </div>
        </td>
      </tr>

      <tr>
        <td class="section" style="padding:22px 20px;border-top:1px solid #272a30;">
          <div class="box" style="border:1px solid #2a2a2a;border-radius:8px;padding:20px;background:#0d0e10;">
            <h3 class="heading mobile-section-title" style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:22px;margin:0 0 16px;letter-spacing:1px;text-transform:uppercase;">WHAT YOU RECEIVED</h3>
            <table class="items" role="presentation" width="100%" style="width:100%;border:1px solid #222;border-radius:6px;overflow:hidden;border-collapse:collapse;">
              <tr>
                <th class="mobile-table-header" style="text-align:center;font-size:12px;color:#efcb4a;background:#13161b;padding:12px;border-bottom:1px solid #2d313a;">ITEM</th>
                <th class="mobile-table-header" style="text-align:left;font-size:12px;color:#efcb4a;background:#13161b;padding:12px;border-bottom:1px solid #2d313a;">DETAILS</th>
                <th class="mobile-table-header" style="text-align:center;font-size:12px;color:#efcb4a;background:#13161b;padding:12px;border-bottom:1px solid #2d313a;">QTY</th>
                <th class="mobile-table-header" style="text-align:right;font-size:12px;color:#efcb4a;background:#13161b;padding:12px;border-bottom:1px solid #2d313a;">PRICE</th>
              </tr>
              {{#each items}}
              <tr>
                <td class="mobile-table-cell" style="padding:16px 10px; border-bottom:1px solid #292d37; vertical-align:middle; width:80px; text-align:center;"><img class="thumb mobile-thumb" src="{{imageUrl}}" alt="{{name}}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid #3a3e48;display:inline-block;" /></td>
                <td class="mobile-table-cell" style="padding:16px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:middle; text-align:left;"><strong style="color:#ffffff;display:block;margin-bottom:4px;">{{name}}</strong><span class="dim" style="color:#b4bac6; font-size:12px;">Size: {{size}} &nbsp;|&nbsp; Color: {{color}}</span></td>
                <td class="mobile-table-cell" style="padding:16px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:middle; text-align:center;"><span style="background:#1a1a1a; padding:4px 12px; border-radius:4px; border:1px solid #333; font-weight:bold;">{{#if quantity}}{{quantity}}{{else}}{{qty}}{{/if}}</span></td>
                <td class="mobile-table-cell" style="padding:16px 10px; color:#d4af37; font-size:14px; font-weight:700; border-bottom:1px solid #292d37; vertical-align:middle; text-align:right;">INR {{subtotal}}</td>
              </tr>
              {{/each}}
              <tr>
                <td colspan="3" class="mobile-table-cell" style="padding:16px 10px; background:#1a1813; color:#d4af37; font-weight:800; font-size:14px; border-bottom:none; text-align:right; text-transform:uppercase; letter-spacing:1px;">Total Paid</td>
                <td class="mobile-table-cell" style="padding:16px 10px; background:#1a1813; color:#d4af37; font-weight:800; font-size:15px; border-bottom:none; text-align:right;">INR {{totalPaid}}</td>
              </tr>
            </table>

            <div style="margin-top:24px;border:1px solid #d4af37;border-radius:12px;padding:24px;background:#111111;text-align:center;">
              <div style="font-size:32px;color:#d4af37;margin-bottom:8px;line-height:1;">&#10022;</div>
              <h4 style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:22px;margin:0 0 8px;">Share the Luxury!</h4>
              <p style="color:#d3c7a8;font-size:15px;margin:0 0 16px;">Refer a friend to eShopper Luxe and you both get <strong>10% OFF</strong> your next purchase.</p>
              <div style="text-align: center; margin-top: 10px;">
                <a class="mobile-btn" href="{{referralShareUrl}}" target="_blank" style="display:inline-block;text-align:center;text-decoration:none;font-weight:700;border-radius:6px;padding:16px 24px;font-size:13px;background:linear-gradient(135deg, #d4af37 0%, #aa8222 100%);color:#000000;letter-spacing:1px;text-transform:uppercase;margin:8px 6px;min-width:200px;box-sizing:border-box;">SHARE &amp; EARN 10% OFF</a>
              </div>
              <div style="margin-top:16px;color:#888;font-size:13px;text-transform:uppercase;letter-spacing:1px;">Your Personal Code</div>
              <div style="margin-top:6px;display:inline-block;background:#0a0a0c;border:1px dashed #d4af37;color:#d4af37;padding:10px 20px;border-radius:6px;font-weight:800;font-size:22px;letter-spacing:3px;">{{referralCode}}</div>
            </div>

            <div style="margin-top:24px;border-top:1px solid #2a2a2a;padding-top:24px;">
              <h4 style="font-family:'Playfair Display', Georgia, serif;color:#d4af37;font-size:20px;margin:0 0 16px;text-align:center;">Important Information</h4>
              <table class="igrid" role="presentation" style="width:100%;border-collapse:collapse;">
                <tr>
                  <td class="mobile-stack" style="width:50%;padding-right:4px;vertical-align:top;">
                    <div style="border:1px solid #2a2a2a;border-radius:8px;background:#0d0e10;padding:16px;text-align:center;min-height:90px;">
                      <div style="color:#d4af37;font-size:18px;font-family:'Playfair Display', Georgia, serif;margin-bottom:6px;">7-Day Returns</div>
                      <div style="color:#aeb5c6;font-size:14px;line-height:1.45;">Easy returns within 7 days if not satisfied.</div>
                    </div>
                  </td>
                  <td class="mobile-stack" style="width:50%;padding-left:4px;vertical-align:top;">
                    <div style="border:1px solid #2a2a2a;border-radius:8px;background:#0d0e10;padding:16px;text-align:center;min-height:90px;">
                      <div style="color:#d4af37;font-size:18px;font-family:'Playfair Display', Georgia, serif;margin-bottom:6px;">Warranty</div>
                      <div style="color:#aeb5c6;font-size:14px;line-height:1.45;">Keep your tax invoice safe for warranty claims.</div>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </td>
      </tr>

      <tr><td style="padding:24px 20px;border-top:1px solid #2a2e36;text-align:center;background:#0d0e10;">
        <h4 style="font-family:'Playfair Display', Georgia, serif;margin:0 0 16px;font-size:24px;color:#d4af37;font-weight:400;">Need Help or Have Questions?</h4>
        <div style="text-align: center; margin-top: 10px;">
          <a class="mobile-btn" href="{{whatsappUrl}}" target="_blank" style="display:inline-block;text-align:center;text-decoration:none;font-weight:700;border-radius:6px;padding:16px 32px;font-size:13px;background:#06140b;border:1px solid #25d366;color:#25d366;letter-spacing:1px;text-transform:uppercase;margin:8px 6px;min-width:200px;box-sizing:border-box;">WHATSAPP SUPPORT</a>
          <a class="mobile-btn" href="tel:{{supportPhone}}" target="_blank" style="display:inline-block;text-align:center;text-decoration:none;font-weight:700;border-radius:6px;padding:16px 32px;font-size:13px;background:#151820;border:1px solid #756225;color:#f0d07a;letter-spacing:1px;text-transform:uppercase;margin:8px 6px;min-width:200px;box-sizing:border-box;">CALL US</a>
        </div>
        <div style="margin-top:16px;">
          <a href="mailto:{{supportEmail}}" style="color:#d4af37;font-size:15px;text-decoration:none;">{{supportEmail}}</a>
        </div>
      </td></tr>

      <tr><td style="padding:24px 14px;border-top:1px solid #1a1a1a;text-align:center;color:#9ea4b2;font-size:12px;line-height:1.7;background:#0b0c0e;">
        {{> social-footer}}
        {{> brand-story-footer}}
        <div style="margin-top:14px; text-align:center;">&copy; 2024 E-Shopper Boutique Luxe. All rights reserved.</div>
        <div style="text-align:center;">{{companyAddress}}</div>
        <div style="margin-top: 14px; text-align:center;">
          <a href="{{privacyPolicyUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Privacy</a> | 
          <a href="{{termsUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Terms</a> | 
          <a href="{{returnPolicyUrl}}" style="color:#d4af37;text-decoration:none;margin:0 6px;">Return Policy</a>
        </div>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>
         
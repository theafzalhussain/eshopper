<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Received - {{orderId}}</title>
  <style>
    body { margin:0; padding:0; background:#050608; font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif; color:#f4f4f4; }
    table { border-collapse:collapse; }
    img { max-width:100%; height:auto; border:0; display:block; }
    .wrapper { width:100%; background:#050608; padding:16px 6px; }
    .frame { width:100%; max-width:650px; margin:0 auto; background:#0d0f12; border:1px solid #1f2229; border-radius:18px; overflow:hidden; }
    .head { padding:16px 20px; background:linear-gradient(120deg,#151515,#262117); }
    .brand { height:28px; vertical-align:middle; }
    .orderid { float:right; text-align:right; color:#f4d163; font-size:12px; letter-spacing:0.3px; }
    .orderid strong { color:#ffffff; display:block; font-size:34px; margin-top:3px; }
    .hero { background:#dfbe3f; color:#ffffff; text-align:center; padding:16px 10px; }
    .hero .ok { font-size:45px; line-height:1; font-weight:700; }
    .hero .label { font-size:42px; font-weight:800; letter-spacing:0.6px; line-height:1.04; margin-top:6px; }
    .hero .date { font-size:24px; margin-top:8px; }
    .section { padding:20px 22px; border-top:1px solid #20242b; }
    .title { margin:0 0 8px 0; font-size:43px; line-height:1.1; text-align:center; }
    .subtitle { margin:0; text-align:center; color:#c7ccd4; font-size:32px; line-height:1.42; }
    .verify { display:inline-block; margin-top:14px; background:#0d3119; border:1px solid #0f7d3c; color:#7cffaf; border-radius:8px; padding:10px 15px; font-size:26px; font-weight:700; }
    .panel { border:1px solid #2a2f39; border-radius:12px; padding:14px; background:#0f1115; }
    .panel h3 { margin:0 0 12px 0; color:#e8c450; font-size:32px; }
    .items { width:100%; border:1px solid #303542; border-radius:10px; overflow:hidden; }
    .items th { text-align:left; color:#e7c44b; font-size:12px; padding:10px; border-bottom:1px solid #2a2f3a; background:#11141a; }
    .items td { padding:12px 10px; color:#eef0f4; font-size:30px; border-bottom:1px solid #292d37; vertical-align:top; }
    .items tr:last-child td { border-bottom:none; }
    .thumb { width:82px; height:82px; object-fit:cover; border-radius:8px; border:1px solid #343946; }
    .muted { color:#9ba3b2; font-size:26px; line-height:1.3; }
    .cards { width:100%; margin-top:14px; }
    .cards td { width:50%; vertical-align:top; }
    .box { border:1px solid #6f5b20; border-radius:12px; background:linear-gradient(120deg,#1f1b12,#14161b); padding:14px; margin-right:7px; min-height:160px; }
    .box2 { border:1px solid #37404c; border-radius:12px; background:#0f1116; padding:14px; margin-left:7px; min-height:160px; }
    .k { margin:0 0 8px 0; font-size:24px; color:#e8c450; font-weight:700; letter-spacing:0.3px; }
    .v { margin:0; color:#e4e6eb; font-size:31px; line-height:1.38; }
    .pending { color:#11a64e; }
    .totals { margin-top:14px; border:1px solid #323844; border-radius:12px; padding:14px; }
    .totals td { font-size:28px; color:#d6d9df; padding:6px 0; }
    .totals .amount { text-align:right; }
    .totals .final td { color:#e8c450; font-size:40px; font-weight:800; padding-top:10px; }
    .cta { margin-top:15px; text-align:center; }
    .cta a { display:inline-block; min-width:280px; background:#dfbe3f; color:#171717; text-decoration:none; font-weight:800; letter-spacing:0.3px; border-radius:9px; padding:13px 18px; font-size:30px; }
    .note { margin:10px 0 0 0; text-align:center; color:#868d9a; font-size:12px; font-style:italic; }
    .concierge { background:#2a220b; text-align:center; padding:20px 20px 18px; border-top:1px solid #7b6421; }
    .concierge .crown { font-size:40px; }
    .concierge .h { margin:8px 0 6px 0; color:#d7b148; font-size:42px; font-weight:700; }
    .concierge .p { margin:0 auto; max-width:500px; color:#d1b56d; font-size:30px; line-height:1.4; }
    .support { width:100%; margin-top:14px; }
    .support td { width:50%; }
    .support a { display:block; text-align:center; text-decoration:none; border-radius:8px; padding:11px 8px; font-weight:700; font-size:13px; letter-spacing:0.3px; text-transform:uppercase; }
    .wa { margin-right:7px; background:#12d362; color:#0d1a12; }
    .mail { margin-left:7px; background:#0f1116; color:#d8e7ff; border:1px solid #2d5e95; }
    .footer { text-align:center; color:#a3a9b5; font-size:12px; padding:18px 16px 24px; line-height:1.6; }
    .footer a { color:#d4b75a; text-decoration:none; }
    @media only screen and (max-width:620px){
      .head { padding:14px 14px; }
      .brand { height:24px; }
      .orderid { float:none; display:block; text-align:left; margin-top:8px; }
      .hero .ok { font-size:36px; }
      .hero .label { font-size:33px; }
      .hero .date { font-size:17px; }
      .section { padding:16px 12px; }
      .title { font-size:41px; }
      .subtitle { font-size:17px; }
      .verify { font-size:15px; }
      .panel h3 { font-size:28px; }
      .items td { font-size:18px; }
      .muted { font-size:15px; }
      .k { font-size:22px; }
      .v { font-size:14px; }
      .cards td { display:block; width:100%; }
      .box,.box2 { margin:0 0 10px 0; }
      .totals td { font-size:15px; }
      .totals .final td { font-size:35px; }
      .cta a { min-width:100%; font-size:16px; box-sizing:border-box; }
      .concierge .h { font-size:35px; }
      .concierge .p { font-size:17px; }
      .support td { display:block; width:100%; }
      .wa,.mail { margin:0 0 10px 0; }
    }
  </style>
</head>
<body>
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order Received - {{orderId}}. Your order is now in processing.</div>
  <table class="wrapper" role="presentation" width="100%"><tr><td>
    <table class="frame" role="presentation" align="center">
      <tr><td class="head">
        <img src="{{logoUrl}}" alt="eShopper Luxe" class="brand" />
        <div class="orderid">ORDER ID<strong>{{orderId}}</strong></div>
      </td></tr>

      <tr><td class="hero">
        <div class="ok">&#10003;</div>
        <div class="label">ORDER RECEIVED</div>
        <div class="date">{{orderDate}}</div>
      </td></tr>

      <tr><td class="section" style="text-align:center;">
        <h2 class="title">Hi {{customerName}},</h2>
        <p class="subtitle">Your luxury selection is now in our queue. We are verifying your items and preparing them for dispatch.</p>
        <div class="verify">&#10003; Payment Received &amp; Verified</div>
      </td></tr>

      <tr><td class="section">
        <div class="panel">
          <h3>ORDER SUMMARY</h3>
          <table class="items" role="presentation">
            <tr>
              <th>ITEM</th><th>DETAILS</th><th>QTY</th><th>PRICE</th>
            </tr>
            {{#each items}}
            <tr>
              <td><img class="thumb" src="{{imageUrl}}" alt="{{name}}" /></td>
              <td>
                <strong>{{name}}</strong><br>
                <span class="muted">Size: {{size}}</span><br>
                <span class="muted">Color: {{color}}</span>
              </td>
              <td>{{#if quantity}}{{quantity}}{{else}}{{qty}}{{/if}}</td>
              <td>INR {{subtotal}}</td>
            </tr>
            {{/each}}
          </table>

          <table class="cards" role="presentation">
            <tr>
              <td>
                <div class="box">
                  <p class="k">&#128205; SHIPPING TO</p>
                  <p class="v"><strong>{{shippingName}}</strong><br>{{shippingAddressLine1}}<br>{{shippingAddressLine2}}<br>{{shippingAddressLine3}}<br>{{shippingPhone}}</p>
                </div>
              </td>
              <td>
                <div class="box2">
                  <p class="k">PAYMENT METHOD</p>
                  <p class="v">{{paymentMethod}}<br>Status: <span class="pending">{{paymentStatus}}</span></p>
                </div>
              </td>
            </tr>
          </table>

          <div class="totals">
            <table role="presentation" width="100%">
              <tr><td>Subtotal</td><td class="amount">INR {{subtotal}}</td></tr>
              <tr><td>Shipping</td><td class="amount">INR {{shippingCharges}}</td></tr>
              <tr class="final"><td>Total Amount</td><td class="amount">INR {{totalAmount}}</td></tr>
            </table>
          </div>

          <div class="cta"><a href="{{trackingUrl}}">VIEW ORDER STATUS</a></div>
           <a class="cta" href="{{placedInvoiceUrl}}" style="margin-top:10px;background:#2f6fed;">VIEW INVOICE</a>
          <p class="note">* This is an order receipt, not a Tax Invoice. Tax Invoice will be provided upon delivery.</p>
        </div>
      </td></tr>

      <tr><td class="concierge">
        <div class="crown">&#128081;</div>
        <p class="h">Personal Concierge</p>
        <p class="p">Our dedicated team is here to assist with any questions about your order. Reach out anytime!</p>
        <table class="support" role="presentation">
          <tr>
            <td><a class="wa" href="{{whatsappUrl}}">WhatsApp Support</a></td>
            <td><a class="mail" href="mailto:{{supportEmail}}">Email Us</a></td>
          </tr>
        </table>
      </td></tr>

      <tr><td class="footer">
        <div>&copy; 2026 eShopper Luxe. All rights reserved.</div>
        <div>{{companyAddress}}</div>
        <div><a href="{{privacyPolicyUrl}}">Privacy Policy</a> &nbsp; | &nbsp; <a href="{{termsUrl}}">Terms of Service</a></div>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>



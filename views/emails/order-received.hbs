<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Received - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    a:hover { opacity: 0.85; }
    @media only screen and (max-width:620px){
      .cards td { display:block !important; width:100% !important; }
      .box, .box2 { margin:0 0 10px 0 !important; }
      .support td { display:block !important; width:100% !important; }
      /* Premium Delivery Progress Styles */
      .step-icon-done { border-color: #d4af37 !important; background: #1a1813 !important; color: #d4af37 !important; }
      .step-label-done { color: #d4af37 !important; }
      .step-icon-active { border-color: #f8d98a !important; background: linear-gradient(135deg, #d4af37 0%, #aa8222 100%) !important; color: #000000 !important; box-shadow: 0 0 14px rgba(212,175,55,0.6) !important; }
      .step-label-active { color: #f8d98a !important; font-weight: 800 !important; }
      .step-icon-pending { border-color: #222222 !important; background: #0a0a0c !important; color: #555555 !important; }
      .step-label-pending { color: #666666 !important; }
      .step-icon-done, .step-icon-active, .step-icon-pending { width: 22px !important; height: 22px !important; line-height: 20px !important; font-size: 10px !important; margin-bottom: 6px !important; border-width: 1px !important; }
      .step-label-done, .step-label-active, .step-label-pending { font-size: 8px !important; letter-spacing: 0px !important; }
      .luxe-journey-title { font-size: 14px !important; }
      .luxe-percent-pill { font-size: 9px !important; padding: 4px 8px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#050608;font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#f5f5f5;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{orderId}} received. Premium processing in progress.</div>
  {{> animated-gold-border}}
  <table role="presentation" width="100%" style="width:100%;background:#050608;padding:16px 6px;"><tr><td>
    <table role="presentation" align="center" style="width:100%;max-width:640px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:18px;overflow:hidden;">
      <tr><td style="padding:16px 20px;background:linear-gradient(120deg,#0d2315,#12311f,#1b3a2b);">
        <table role="presentation" style="display:inline-table;vertical-align:middle;border-collapse:collapse;">
          <tr>
            <td style="padding-right:8px;vertical-align:top;">
              <span style="background:linear-gradient(145deg,#0f172a 0%,#1e293b 55%,#0f172a 100%);color:#fff;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:800;border-radius:4px;border-right:3px solid #d4af37;box-shadow:0 6px 16px rgba(15,23,42,0.22);line-height:34px;">E</span>
            </td>
            <td style="vertical-align:top;">
              <span style="display:block;font-weight:800;letter-spacing:2.4px;font-size:18px;color:#f5f7fb;line-height:1;">SHOPPER</span>
              <span style="display:block;font-size:7px;letter-spacing:1.8px;color:#d4af37;font-weight:700;margin-top:2px;line-height:1.1;">BOUTIQUE LUXE</span>
            </td>
          </tr>
        </table>
        <span style="float:right;display:inline-block;font-size:12px;font-weight:700;color:#dbffe8;border:1px solid #4aba65;background:#2f8d44;padding:7px 12px;border-radius:999px;">RECEIVED</span>
      </td></tr>
      <tr><td style="background:linear-gradient(120deg,#151515,#262117);border-bottom:3px solid #d4af37;text-align:center;padding:22px 12px;">
        <div style="font-family:'Brush Script MT',cursive,Georgia,serif;font-size:28px;color:#d4af37;margin-bottom:6px;">Thank you, {{customerName}}!</div>
        <div style="font-size:38px;font-weight:800;line-height:1;letter-spacing:.4px;">ORDER RECEIVED</div>
        <div style="color:#f8d98a;font-size:16px;opacity:.96;margin-top:8px;">Order #{{orderId}} | {{orderDate}}</div>
      </td></tr>

      <tr><td style="padding:22px 20px;border-top:1px solid #272a30;">
        <h2 style="margin:0 0 8px 0; font-size:32px; line-height:1.1; text-align:center; font-family:Georgia, serif; color:#d4af37;">Hi {{customerName}}!</h2>
        <p style="margin:0; text-align:center; color:#c7ccd4; font-size:16px; line-height:1.5;">Your order has been received and is now being processed by our expert team. Every item will undergo our strict 10-point quality inspection before dispatch.</p>
        
        <div style="text-align:center;margin-top:20px;padding:16px;background:#111317;border-radius:12px;border:1px solid #333742;">
          <div style="font-size:12px;color:#888;letter-spacing:1px;margin-bottom:4px;font-weight:700;">EXPECTED CONFIRMATION</div>
          <div style="font-size:24px;color:#d4af37;font-weight:700;">{{expectedConfirmation}}</div>
          <div style="font-size:14px;color:#aaa;margin-top:4px;">1-2 Business Days</div>
        </div>

        <div style="margin-top:28px; background:linear-gradient(145deg, #0a0a0c, #111111); border:1px solid #2a2a2a; border-radius:16px; padding:24px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
          <table role="presentation" style="width:100%; margin-bottom:20px;">
            <tr>
              <td class="luxe-journey-title" style="font-family:'Playfair Display', Georgia, serif; font-size:18px; color:#d4af37; font-weight:600; letter-spacing:1px;">
                The Luxe Journey
              </td>
              <td align="right">
                <span class="luxe-percent-pill" style="font-size:10px; background:linear-gradient(135deg, #1a1813, #0a0a0c); color:#d4af37; padding:6px 12px; border-radius:999px; font-weight:800; border:1px solid #d4af37; letter-spacing:1.5px; box-shadow: 0 0 10px rgba(212,175,55,0.15);">
                  {{progressPercent}}% COMPLETE
                </span>
              </td>
            </tr>
          </table>

          <div style="width:100%; height:4px; background:#1a1a1a; border-radius:4px; margin-bottom:24px; overflow:hidden; border: 1px solid #222;">
            <div style="height:100%; background:linear-gradient(90deg, #8b6a12, #d4af37, #fffbe6); width:{{progressPercent}}%; border-radius:4px; box-shadow: 0 0 12px rgba(212,175,55,0.8);"></div>
          </div>

          <table role="presentation" style="width:100%; text-align:center; table-layout:fixed;">
            <tr>
              {{#each progressSteps}}
              <td style="vertical-align:top; padding:0 2px;">
                <div class="step-icon-{{state}}" style="display:inline-block; width:32px; height:32px; line-height:30px; border-radius:50%; font-size:13px; margin-bottom:10px; border: 2px solid #222; background: #0a0a0c; color: #555; box-sizing:border-box;">
                  {{{icon}}}
                </div>
                <div class="step-label-{{state}}" style="font-size:10px; color:#666; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; line-height:1.4;">
                  {{label}}
                </div>
              </td>
              {{/each}}
            </tr>
          </table>

          <div style="margin-top:24px; padding-top:16px; border-top:1px solid #222; font-size:11px; color:#888; text-align:center; font-style:italic; font-family:Georgia, serif;">
            Live status synced automatically with our premium dispatch center.
          </div>
        </div>
      </td></tr>

      <tr><td style="background:#032312;border-top:1px solid #0f4f2a;border-bottom:1px solid #0f4f2a;padding:18px 12px;">
        <h3 style="margin:0 0 16px 0; color:#d4af37; font-size:18px; text-align:center; letter-spacing:1px; font-family:Georgia, serif;">THE LUXE PROMISE</h3>
        <table role="presentation" style="width:100%; text-align:center;"><tr>
          <td style="vertical-align:top; width:33.33%; padding:0 5px;"><span style="display:block; font-size:24px; color:#d4af37; margin-bottom:8px;">&#10003;</span><div style="font-size:14px; font-weight:700; color:#fff; margin-bottom:4px;">Quality Check</div><div style="font-size:12px; color:#aaa; line-height:1.4;">10-point inspection by experts</div></td>
          <td style="vertical-align:top; width:33.33%; padding:0 5px;"><span style="display:block; font-size:24px; color:#d4af37; margin-bottom:8px;">&#9671;</span><div style="font-size:14px; font-weight:700; color:#fff; margin-bottom:4px;">Premium Packaging</div><div style="font-size:12px; color:#aaa; line-height:1.4;">Eco-friendly luxury boxes</div></td>
          <td style="vertical-align:top; width:33.33%; padding:0 5px;"><span style="display:block; font-size:24px; color:#d4af37; margin-bottom:8px;">&#9679;</span><div style="font-size:14px; font-weight:700; color:#fff; margin-bottom:4px;">100% Authentic</div><div style="font-size:12px; color:#aaa; line-height:1.4;">Guaranteed genuine products</div></td>
        </tr></table>
      </td></tr>

      <tr><td style="padding:22px 20px;border-top:1px solid #272a30;">
        <div style="border:1px solid #333742;border-radius:12px;padding:16px;background:#111317;">
          <h3 style="color:#f0c84a;font-size:34px;margin:0 0 14px;">ORDER DETAILS</h3>
          <table role="presentation" width="100%" style="width:100%;border:1px solid #363a45;border-radius:10px;overflow:hidden;border-collapse:collapse;">
            <tr><th style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">ITEM</th><th style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">DETAILS</th><th style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">QTY</th><th style="text-align:left;font-size:13px;color:#efcb4a;background:#13161b;padding:10px;border-bottom:1px solid #2d313a;">PRICE</th></tr>
            {{#each items}}
            <tr>
              <td style="padding:12px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:top;"><img src="{{imageUrl}}" alt="{{name}}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid #3a3e48;max-width:100%;display:block;" /></td>
              <td style="padding:12px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:top;"><strong>{{name}}</strong><br><span style="color:#b4bac6;">Size: {{size}}</span><br><span style="color:#b4bac6;">Color: {{color}}</span></td>
              <td style="padding:12px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:top;">{{#if quantity}}{{quantity}}{{else}}{{qty}}{{/if}}</td>
              <td style="padding:12px 10px; color:#eef0f4; font-size:14px; border-bottom:1px solid #292d37; vertical-align:top;">INR {{subtotal}}</td>
            </tr>
            {{/each}}
          </table>

          <div style="margin-top:14px;border:1px solid #343844;border-radius:12px;padding:16px;">
            <table role="presentation" style="width:100%;">
              <tr><td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Item Price</td><td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{subtotal}}</td></tr>
              <tr><td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Shipping Charges</td><td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{shippingCharges}}</td></tr>
              <tr><td style="padding:5px 0;color:#d5d9e2;font-size:16px;">GST (Included)</td><td align="right" style="padding:5px 0;color:#d5d9e2;font-size:16px;">INR {{gst}}</td></tr>
              <tr><td style="border-top:1px solid #2c3140;padding-top:10px;color:#efcb4a;font-size:48px;font-weight:800;">Total Amount Paid</td><td align="right" style="border-top:1px solid #2c3140;padding-top:10px;color:#efcb4a;font-size:48px;font-weight:800;">INR {{totalPaid}}</td></tr>
              <tr><td style="padding:5px 0;color:#d5d9e2;font-size:16px;">Payment Mode: {{paymentMethod}}</td><td style="color:#21c05c;font-size:14px;text-align:right;padding-top:0;">&#10003; PAID</td></tr>
            </table>
          </div>

          <table role="presentation" class="cards" style="width:100%;margin-top:14px;"><tr>
            <td style="width:50%;vertical-align:top;"><div class="box" style="border:1px solid #0f6f35;background:#101a12;border-radius:12px;padding:14px;margin-right:8px;"><div style="font-size:13px;color:#36d76d;margin-bottom:8px;font-weight:700;letter-spacing:.3px;">SHIPPING ADDRESS</div><div style="color:#e7e9ed;font-size:16px;line-height:1.45;">{{shippingName}}<br>{{shippingAddressLine1}}<br>{{shippingAddressLine2}}<br>{{shippingAddressLine3}}<br>Phone: {{shippingPhone}}</div></div></td>
            <td style="width:50%;vertical-align:top;"><div class="box2" style="border:1px solid #343944;background:#111317;border-radius:12px;padding:14px;margin-left:8px;"><div style="font-size:13px;color:#efcb4a;margin-bottom:8px;font-weight:700;letter-spacing:.3px;">BILLING INFO</div><div style="color:#e7e9ed;font-size:16px;line-height:1.45;">{{customerName}}<br>Email: {{customerEmail}}<br>Transaction ID:<br><span style="color:#e0bc52;">{{transactionId}}</span></div></div></td>
          </tr></table>

          <a href="{{trackingUrl}}" style="display:block;text-align:center;text-decoration:none;font-weight:800;border-radius:10px;padding:14px 12px;font-size:24px;margin-top:14px;background:#4ab75a;color:#fff;">TRACK YOUR ORDER</a>
          <a href="{{placedInvoiceUrl}}" style="display:block;text-align:center;text-decoration:none;font-weight:800;border-radius:10px;padding:14px 12px;font-size:24px;margin-top:14px;background:#151820;color:#f0d07a;border:1px solid #756225;">VIEW RECEIPT</a>
        </div>
      </td></tr>

      <tr><td style="padding:18px 14px 24px;border-top:1px solid #272a30;text-align:center;color:#9ea4b2;font-size:12px;line-height:1.7;">
        <div style="color:#d6f7e0;font-size:16px;">Join our 50,000+ Luxe community</div>
        <div style="color:#f4d64b;font-size:28px;letter-spacing:2px;margin:8px 0;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <a href="{{instagramUrl}}" style="display:inline-block;background:linear-gradient(90deg,#ff8d3a,#d84ee4);color:#fff;text-decoration:none;border-radius:999px;padding:12px 22px;font-weight:700;font-size:18px;">Follow us on Instagram</a>
      </td></tr>

      <tr><td style="padding:18px 20px;border-top:1px solid #2a2e36;text-align:center;">
        <h4 style="margin:0 0 10px;font-size:36px;color:#f1f2f5;">Need Assistance?</h4>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;">
          <a href="{{whatsappUrl}}" style="display:inline-block;width:48%;min-width:180px;margin:6px 0;padding:16px 0;border-radius:10px;text-decoration:none;font-weight:800;font-size:18px;background:linear-gradient(90deg,#25d366,#1ed66d);color:#0f1912;text-align:center;box-shadow:0 2px 8px rgba(34,139,34,0.08);">WhatsApp Support</a>
          <a href="{{instagramUrl}}" style="display:inline-block;width:48%;min-width:180px;margin:6px 0;padding:16px 0;border-radius:10px;text-decoration:none;font-weight:800;font-size:18px;background:linear-gradient(90deg,#ff8d3a,#d84ee4);color:#fff;text-align:center;box-shadow:0 2px 8px rgba(216,78,228,0.08);">Instagram</a>
        </div>
      </td></tr>

      <tr><td style="text-align:center;color:#9ea4b2;font-size:12px;padding:18px 14px 24px;border-top:1px solid #272a30;line-height:1.7;">
        {{> review-snippet}}
        {{> social-footer}}
        {{> brand-story-footer}}
        <div>&copy; 2026 eShopper Luxe. All rights reserved.</div>
        <div>{{companyAddress}}</div>
        <div>GSTIN: {{companyGstin}} | CIN: {{companyCin}}</div>
        <div><a href="{{privacyPolicyUrl}}" style="color:#d4b75a;text-decoration:none;margin:0 6px;">Privacy</a> | <a href="{{termsUrl}}" style="color:#d4b75a;text-decoration:none;margin:0 6px;">Terms</a> | <a href="{{unsubscribeUrl}}" style="color:#d4b75a;text-decoration:none;margin:0 6px;">Unsubscribe</a></div>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>

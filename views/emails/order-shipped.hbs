<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Shipped - {{orderId}}</title>
  <style>
    {{> theme_tokens}}
    body{margin:0;padding:0;background:#050608;font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#f5f5f5;}
    table{border-collapse:collapse;}
    img{max-width:100%;height:auto;border:0;display:block;}
    .wrap{width:100%;background:#050608;padding:16px 6px;}
    .card{width:100%;max-width:640px;margin:0 auto;background:#131416;border:1px solid #23262b;border-radius:18px;overflow:hidden;}
    .top{padding:16px 20px;background:linear-gradient(120deg,#091a2d,#0c2742,#12345a);}
    .brandmark{display:inline-table;vertical-align:middle;border-collapse:collapse;}
    .brandmark td{padding:0;vertical-align:top;}
    .brandmark-e-cell{padding-right:8px !important;}
    .brandmark-e{background:linear-gradient(145deg,#0f172a 0%,#1e293b 55%,#0f172a 100%);color:#fff;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-size:21px;font-weight:800;border-radius:4px;border-right:3px solid #d4af37;box-shadow:0 6px 16px rgba(15,23,42,0.22);line-height:34px;}
    .brandmark-text{display:table-cell;line-height:1;}
    .brandmark-name{display:block;font-weight:800;letter-spacing:2.4px;font-size:18px;color:#f5f7fb;line-height:1;}
    .brandmark-tag{display:block;font-size:7px;letter-spacing:1.8px;color:#d4af37;font-weight:700;margin-top:2px;line-height:1.1;}
    .status{float:right;display:inline-block;font-size:12px;font-weight:700;color:#dbf0ff;border:1px solid #40a5ff;background:#2f9bf0;padding:7px 12px;border-radius:999px;}
    .hero{background:#3b9be6;color:#fff;text-align:center;padding:28px 12px;}
    .hero .icon{font-size:48px;line-height:1;}
    .hero .t{font-size:48px;font-weight:800;line-height:1;margin-top:8px;letter-spacing:.5px;}
    .hero .s{font-size:14px;opacity:.96;margin-top:8px;}
    .section{padding:22px 20px;border-top:1px solid #272a30;}
    .title{margin:0 0 10px;font-size:44px;line-height:1.08;text-align:center;}
    .sub{text-align:center;color:#d6dae2;font-size:17px;line-height:1.62;margin:0;}
    .cta-strip{padding:18px 20px;background:#041b35;border-top:1px solid #103761;border-bottom:1px solid #103761;}
    .btn{display:block;text-align:center;text-decoration:none;font-weight:800;border-radius:10px;padding:14px 12px;font-size:24px;margin-top:14px;}
    .btn-primary{background:#3da5ff;color:#fff;margin-top:0;}
    .box{border:1px solid #1982dd;border-radius:12px;padding:16px;background:#111317;}
    .heading{color:#1998ff;font-size:32px;margin:0 0 14px;}
    .summary{width:100%;border:1px solid #2d4e6b;border-radius:12px;overflow:hidden;}
    .summary td{padding:12px 10px;border-bottom:1px solid #27435b;font-size:16px;color:#e7e9ed;}
    .summary tr:last-child td{border-bottom:none;}
    .summary .k{color:#bfc3ce;}
    .summary .v{color:#ffffff;font-weight:700;text-align:right;}
    .summary .awb{display:inline-block;background:#002c52;color:#1fa3ff;padding:5px 10px;border-radius:6px;}
    .summary .eta{color:#22b34f;font-weight:800;}
    .progress-track{margin-top:14px;border:1px solid #323844;border-radius:12px;padding:14px;background:#111317;}
    .progress-head{margin:0 0 10px;color:#efcb4a;font-size:30px;letter-spacing:.3px;text-align:center;font-weight:800;}
    .progress-grid{width:100%;}
    .progress-grid td{text-align:center;padding:4px 2px;width:20%;}
    .p-icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:999px;font-size:18px;border:1px solid #3a404d;background:#1b212d;}
    .p-icon.done{background:#2ea94b;border-color:#55d372;}
    .p-icon.active{background:#2f8fe2;border-color:#6fc3ff;box-shadow:0 0 0 3px rgba(47,143,226,0.22);}
    .p-icon.pending{background:#1b212d;border-style:dashed;color:#8a93a5;}
    .p-label{margin-top:6px;font-size:11px;letter-spacing:.4px;font-weight:700;color:#8f98aa;text-transform:uppercase;}
    .p-label.done{color:#5fda7f;}
    .p-label.active{color:#7bc6ff;}
    .p-bar{margin-top:10px;height:4px;background:#2a2e37;border-radius:999px;overflow:hidden;}
    .p-fill{height:100%;background:linear-gradient(90deg,#34d399,#60a5fa,#a78bfa);border-radius:999px;}
    .items-title{margin:14px 0 8px;color:#efcb4a;font-size:30px;font-weight:800;}
    .items{width:100%;margin-top:0;border:1px solid #363a45;border-radius:10px;overflow:hidden;}
    .items td{padding:12px 10px;font-size:16px;color:#eceef2;border-bottom:1px solid #2c3039;vertical-align:middle;}
    .items tr:last-child td{border-bottom:none;}
    .thumb{width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid #3a3e48;}
    .addr{margin-top:14px;border:1px solid #1779cc;background:#0a2034;border-radius:12px;padding:14px;}
    .addr h4{margin:0 0 8px;color:#1ea0ff;font-size:28px;}
    .addr p{margin:0;color:#d6e6f6;line-height:1.5;font-size:17px;}
    .tips{margin-top:14px;border-left:4px solid #e0bf3f;background:#2b2211;border-radius:10px;padding:12px;}
    .tips h4{margin:0 0 8px;color:#efcb4a;font-size:26px;}
    .tips ul{margin:0;padding-left:18px;color:#d3c7a8;font-size:17px;line-height:1.55;}
    .btn-row{width:100%;margin-top:12px;}
    .btn-row td{width:50%;}
    .btn-sm{display:block;text-align:center;text-decoration:none;font-weight:700;border-radius:10px;padding:11px 8px;font-size:16px;}
    .live{background:#3da5ff;color:#fff;margin-right:8px;}
    .carrier{background:#141923;color:#3da5ff;border:1px solid #2d75ad;margin-left:8px;}
    .assist{padding:18px 20px;border-top:1px solid #2a2e36;text-align:center;}
    .assist h4{margin:0 0 10px;font-size:32px;color:#f1f2f5;}
    .chat{display:inline-block;margin:6px;padding:10px 14px;border-radius:10px;background:#25d366;color:#0f1712;text-decoration:none;font-weight:700;font-size:15px;}
    .call{display:inline-block;margin:6px;padding:10px 14px;border-radius:10px;background:#121620;color:#9cc9ff;border:1px solid #2a5586;text-decoration:none;font-weight:700;font-size:15px;}
    .foot{padding:18px 14px 24px;border-top:1px solid #272a30;text-align:center;color:#9ea4b2;font-size:12px;line-height:1.7;}
    .foot a{color:#d4b75a;text-decoration:none;}
    @media only screen and (max-width:620px){
      .status{float:none;display:inline-block;margin-top:8px;}
      .hero .t{font-size:38px;}
      .title{font-size:34px;}
      .sub{font-size:16px;}
      .p-icon{width:32px;height:32px;font-size:16px;}
      .p-label{font-size:10px;}
      .btn{font-size:21px;}
      .btn-row td{display:block;width:100%;}
      .live,.carrier{margin:0 0 10px 0;}
      .assist h4{font-size:26px;}
    }
  </style>
</head>
<body>
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">Order {{orderId}} shipped. Track your package now.</div>
  <table class="wrap" role="presentation" width="100%"><tr><td>
    <table class="card" role="presentation" align="center">
      <tr><td class="top"><table role="presentation" class="brandmark" cellpadding="0" cellspacing="0"><tr><td class="brandmark-e-cell"><span class="brandmark-e">E</span></td><td class="brandmark-text"><span class="brandmark-name">SHOPPER</span><span class="brandmark-tag">BOUTIQUE LUXE</span></td></tr></table><span class="status">ON THE WAY</span></td></tr>
      <tr><td class="hero"><div class="icon">&#10148;</div><div class="t">YOUR ORDER IS SHIPPED</div><div class="s">Track your luxury package in real-time</div></td></tr>

      <tr><td class="section">
        <h2 class="title">Exciting News, {{customerName}}</h2>
        <p class="sub">Your luxury package has left our warehouse and is now en route to you. Track your delivery in real-time using the details below.</p>
      </td></tr>

      <tr><td class="cta-strip">
        <a class="btn btn-primary" href="{{liveTrackingUrl}}">TRACK PACKAGE NOW</a>
      </td></tr>

      <tr><td class="section">
        <div class="box">
          <h3 class="heading">SHIPMENT INFORMATION</h3>
          <table class="summary" role="presentation" width="100%">
            <tr><td class="k">Courier Partner</td><td class="v">{{courierPartner}}</td></tr>
            <tr><td class="k">AWB Tracking Number</td><td class="v"><span class="awb">{{trackingNumber}}</span></td></tr>
            <tr><td class="k">Shipped On</td><td class="v">{{shippedOn}}</td></tr>
            <tr><td class="k">Expected Delivery</td><td class="v eta">{{expectedDelivery}}</td></tr>
          </table>

          <div class="progress-track">
            <div class="progress-head">DELIVERY PROGRESS</div>
            <table class="progress-grid" role="presentation"><tr>
              {{#each progressSteps}}
              <td>
                <span class="p-icon {{state}}">{{{icon}}}</span>
                <div class="p-label {{state}}">{{label}}</div>
              </td>
              {{/each}}
            </tr></table>
            <div class="p-bar"><div class="p-fill" style="width: {{progressPercent}}%;"></div></div>
          </div>

          <div class="items-title">WHAT'S IN YOUR PACKAGE</div>
          <table class="items" role="presentation" width="100%">
            {{#each items}}
            <tr>
              <td><img class="thumb" src="{{imageUrl}}" alt="{{name}}" /></td>
              <td><strong>{{name}}</strong><br><span style="color:#b4bac6;">Qty: {{#if quantity}}{{quantity}}{{else}}{{qty}}{{/if}}</span></td>
              <td>INR {{subtotal}}</td>
            </tr>
            {{/each}}
          </table>

          <div class="addr">
            <h4>DELIVERING TO</h4>
            <p><strong>{{shippingName}}</strong><br>{{shippingAddressLine1}}<br>{{shippingAddressLine2}}<br>{{shippingAddressLine3}}<br>{{shippingPhone}}</p>
          </div>

          <div class="tips">
            <h4>IMPORTANT DELIVERY TIPS</h4>
            <ul>
              <li>Keep your phone accessible for delivery updates.</li>
              <li>Ensure someone is available at the delivery address.</li>
              <li>Check package condition before accepting delivery.</li>
            </ul>
          </div>

          <table class="btn-row" role="presentation"><tr>
            <td><a class="btn-sm live" href="{{liveTrackingUrl}}">LIVE TRACKING</a></td>
            <td><a class="btn-sm carrier" href="{{carrierWebsiteUrl}}">CARRIER WEBSITE</a></td>
          </tr></table>
        </div>
      </td></tr>

      <tr><td class="assist">
        <h4>Need Help with Your Delivery?</h4>
        <a class="chat" href="{{whatsappUrl}}">Chat Support</a>
        <a class="call" href="tel:{{supportPhone}}">Call Us</a>
      </td></tr>

      <tr><td class="foot">
        <div>&copy; 2026 eShopper Luxe. All rights reserved.</div>
        <div>{{companyAddress}}</div>
        <div><a href="{{privacyPolicyUrl}}">Privacy</a> &nbsp; | &nbsp; <a href="{{termsUrl}}">Terms</a></div>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OTP Verification</title>
  <style>
    {{> theme_tokens}}
    body{margin:0;padding:0;background:radial-gradient(circle at 20% -10%,#2a3d64 0,#0a0d13 45%,#07090d 100%);font-family:'Trebuchet MS','Segoe UI','Helvetica Neue',Arial,sans-serif;color:#eef2fa;}
    table{border-collapse:collapse;}
    .wrap{padding:24px 10px;}
    .card{width:100%;max-width:640px;margin:0 auto;background:#0d111a;border:1px solid #273246;border-radius:20px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.35);}
    .top{padding:16px 20px;background:linear-gradient(120deg,#0f1828,#1a2b46,#9a8441);font-size:12px;letter-spacing:1px;font-weight:700;color:#f7df95;text-transform:uppercase;text-align:center;}
    .hero{padding:28px 20px 22px;background:linear-gradient(180deg,#1a2539,#121a2a);text-align:center;border-bottom:1px solid #2a3447;}
    .hero h1{margin:0;font-size:38px;line-height:1.05;color:#f9fbff;font-family:Georgia,'Times New Roman',serif;letter-spacing:.6px;}
    .hero p{margin:10px 0 0;color:#b4c0d9;font-size:15px;line-height:1.5;}
    .sec{padding:24px 22px;}
    .sec h2{margin:0 0 10px;font-size:30px;line-height:1.1;color:#ffffff;font-family:Georgia,'Times New Roman',serif;}
    .sec p{margin:0 0 12px;color:#d4dced;font-size:16px;line-height:1.65;}
    .otp-wrap{margin:18px 0 16px;padding:12px;border:1px solid #2d3d5f;border-radius:14px;background:linear-gradient(140deg,#0a1425,#111c2e);}
    .otp{margin:0 auto;max-width:310px;text-align:center;background:#08101d;border:1px solid #35517d;border-radius:12px;padding:14px 16px;font-size:52px;font-weight:800;letter-spacing:9px;color:#65f7be;line-height:1;}
    .meta{margin:14px 0 0;font-size:13px;color:#9fb0cc;}
    .help{margin-top:14px;color:#b8c4d9;font-size:14px;line-height:1.6;word-break:break-word;}
    .help a{color:#6bb8ff;}
    .cta{margin-top:18px;}
    .btn{display:inline-block;padding:12px 16px;border-radius:11px;text-decoration:none;font-size:14px;font-weight:700;}
    .btn-primary{background:linear-gradient(90deg,#1d9fff,#266bff);color:#ffffff;}
    .btn-secondary{background:#111827;color:#cde3ff;border:1px solid #355486;margin-left:8px;}
    .security{margin-top:16px;padding:12px;border:1px dashed #324767;border-radius:10px;background:#0b1220;color:#9fb1cc;font-size:13px;line-height:1.6;}
    .foot{padding:16px;border-top:1px solid #2a3447;text-align:center;color:#93a3be;font-size:12px;line-height:1.65;background:#0a0f17;}
    @media only screen and (max-width:620px){
      .wrap{padding:14px 6px;}
      .card{border-radius:16px;}
      .hero{padding:22px 16px 18px;}
      .hero h1{font-size:30px;}
      .hero p{font-size:14px;}
      .sec{padding:18px 16px;}
      .sec h2{font-size:26px;}
      .sec p{font-size:15px;}
      .otp{font-size:42px;letter-spacing:7px;max-width:100%;}
      .btn{display:block;width:100%;text-align:center;box-sizing:border-box;}
      .btn-secondary{margin-left:0;margin-top:8px;}
    }
  </style>
</head>
<body>
  <table role="presentation" width="100%" class="wrap">
    <tr>
      <td>
        <table role="presentation" class="card" align="center">
          <tr><td class="top">ESHOPPER PREMIUM ACCOUNT SECURITY</td></tr>
          <tr>
            <td class="hero">
              <h1>OTP VERIFICATION</h1>
              <p>Your secure access key is ready. Please verify within 10 minutes.</p>
            </td>
          </tr>
          <tr>
            <td class="sec">
              <h2>Hi {{userName}},</h2>
              <p>Use the one-time code below to continue safely.</p>
              <div class="otp-wrap">
                <div class="otp">{{otp}}</div>
              </div>
              <p class="meta">Code expires in 10 minutes. Do not share this code with anyone.</p>
              <div class="help">Need help? <a href="mailto:{{supportEmail}}">{{supportEmail}}</a> | {{supportPhone}}</div>
              <div class="cta">
                <a class="btn btn-primary" href="{{websiteUrl}}">Open eShopper</a>
                <a class="btn btn-secondary" href="mailto:{{supportEmail}}">Email Support</a>
              </div>
              <div class="security">If this OTP was not requested by you, ignore this email and reset your account password immediately for safety.</div>
            </td>
          </tr>
          <tr><td class="foot">{{companyAddress}}</td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>



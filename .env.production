# Disable ESLint warnings during production build
# This prevents build failures due to ESLint warnings
DISABLE_ESLINT_PLUGIN=true

# Generate source maps for debugging (optional, can be set to false for faster builds)
GENERATE_SOURCEMAP=false

# API target for production build
REACT_APP_API_URL=https://eshopper-qtgl.onrender.com

# Invoice mode: keep false while server-side Puppeteer invoice is under maintenance.
REACT_APP_USE_SERVER_INVOICE=false

